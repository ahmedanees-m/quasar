# credentials, never committed
.env
*.token
*token*.txt
.qiskit/
~/.qiskit/

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# large intermediates, never committed
scratch/
*.npy
*.npz
*.h5
*.hdf5
*.tar
*.tar.gz

# results: small JSON gate records are committed, bulk sweep output is not
results/**/*.parquet
results/**/raw/
results/**/scratch/

# figures are regenerated by script; only the final publication set is committed
figures/**/draft/

# os
.DS_Store
Thumbs.db
desktop.ini

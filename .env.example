# Copy to .env and fill in. .env is gitignored and must never be committed.
# Credentials live here and nowhere else in the repository.

# Compute VM
QUASAR_VM_HOST=
QUASAR_VM_USER=
QUASAR_VM_PORT=22
# Prefer a key over a password. Set QUASAR_VM_KEY and leave QUASAR_VM_PASS empty.
QUASAR_VM_KEY=
QUASAR_VM_PASS=

# Absolute path of the repository working tree on the VM
QUASAR_VM_ROOT=/home/<user>/QUASAR/quasar

# Absolute path of the Drive archive directory on the laptop
QUASAR_ARCHIVE=G:/My Drive/Qubis_HiQ/QUASAR/archive

# Live QPU (WP8 only). backends/qpu.py reads this and fails with a clear message if absent.
QISKIT_IBM_TOKEN=
